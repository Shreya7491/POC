# Copy to `.env` on the EC2 host (same directory as docker-compose.prod.yml)
# when setting things up manually or testing outside of CI.
# In the real deploy, this file is generated by the CI workflow from
# GitHub Actions secrets - see docs/GITHUB_SECRETS.md.

MONGO_ROOT_USER=change-me
MONGO_ROOT_PASSWORD=change-me
MONGO_DB_NAME=hello-app
CORS_ORIGINS=http://your-ec2-public-ip-or-domain
